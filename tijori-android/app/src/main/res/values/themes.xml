<resources>
    <style name="Theme.Tijori" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">#0B1320</item>
        <item name="android:navigationBarColor">#0B1320</item>
        <item name="android:windowBackground">@android:color/white</item>
    </style>
    <style name="Theme.Tijori.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0B1320</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Tijori</item>
    </style>
</resources>
